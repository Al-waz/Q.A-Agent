{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@qa/schemas": ["../packages/schemas/dist/index.d.ts"],
      "@qa/prompts": ["../packages/prompts/dist/index.d.ts"]
    }
  },
  "include": ["./**/*.ts"]
}
