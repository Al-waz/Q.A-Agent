# ============================================================================
# Q&A Agent — Environment Variables
# Copy this file to `.env` and fill in the values marked REQUIRED.
# ============================================================================

# ---------------------------------------------------------------------------
# LLM Provider (OpenRouter — free tier for Qwen 3.6 Plus)
# Sign up at https://openrouter.ai — no credit card required.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=                         # REQUIRED
OPENROUTER_MODEL=qwen/qwen3.6-plus:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Judge model for eval — intentionally a different model to avoid self-bias.
# Free option: qwen/qwen3.6-plus-preview:free. Paid option: anthropic/claude-haiku-4.5
JUDGE_MODEL=qwen/qwen3.6-plus-preview:free

# ---------------------------------------------------------------------------
# Embeddings & Reranking (Voyage AI — 200M free tokens per account)
# Sign up at https://dash.voyageai.com — no credit card required.
# ---------------------------------------------------------------------------
VOYAGE_API_KEY=                             # REQUIRED
VOYAGE_EMBEDDING_MODEL=voyage-4-large
VOYAGE_RERANKER_MODEL=rerank-2.5

# ---------------------------------------------------------------------------
# Vector Database (Weaviate — self-hosted via docker compose)
# ---------------------------------------------------------------------------
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_SCHEME=http
WEAVIATE_COLLECTION=DocumentChunk

# ---------------------------------------------------------------------------
# Retrieval tuning
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K=20                          # broad fetch before rerank
RETRIEVAL_FINAL_K=5                         # after rerank
HYBRID_ALPHA=0.5                            # 0 = keyword only, 1 = vector only

# Chunking
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# Feature flags (bonus features)
ENABLE_RERANKER=true
ENABLE_HYBRID_SEARCH=true
ENABLE_QUERY_REWRITING=true
ENABLE_TOOL_USE=false                       # agent-driven retrieval; default off

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Web (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_PORT=3000
