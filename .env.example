# ============================================================================
# Q&A Agent — Environment Variables
# Copy this file to `.env` and fill in the values marked REQUIRED.
# ============================================================================

# ---------------------------------------------------------------------------
# LLM Provider (OpenRouter — free tier for Qwen 3.6 Plus)
# Sign up at https://openrouter.ai — no credit card required.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=                         # REQUIRED
OPENROUTER_MODEL=qwen/qwen3.6-plus:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Judge model for eval — intentionally a different model to avoid self-bias.
# Free option: qwen/qwen3.6-plus-preview:free. Paid option: anthropic/claude-haiku-4.5
JUDGE_MODEL=qwen/qwen3.6-plus-preview:free

# ---------------------------------------------------------------------------
# Embeddings & Reranking (Jina AI — 1M free tokens/month, no card required)
# Sign up at https://jina.ai/?sui=apikey and copy your key from the dashboard.
# The same key powers both embeddings and reranking (shared free-tier pool).
# ---------------------------------------------------------------------------
JINA_API_KEY=                               # REQUIRED
JINA_EMBEDDING_MODEL=jina-embeddings-v4
JINA_RERANKER_MODEL=jina-reranker-v2-base-multilingual

# ---------------------------------------------------------------------------
# Vector Database (Weaviate — self-hosted via docker compose)
# ---------------------------------------------------------------------------
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_SCHEME=http
WEAVIATE_COLLECTION=DocumentChunk

# ---------------------------------------------------------------------------
# Retrieval tuning
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K=20                          # broad fetch before rerank
RETRIEVAL_FINAL_K=5                         # after rerank
HYBRID_ALPHA=0.5                            # 0 = keyword only, 1 = vector only

# Chunking — semantic strategy: sentence-level embeddings + similarity-based
# boundary detection + section-aware packing + Jina native late chunking
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
SEMANTIC_SIMILARITY_THRESHOLD=0.75          # cosine drop below this = new chunk
JINA_LATE_CHUNKING=true                     # full-doc context via token pooling

# Feature flags (bonus features)
ENABLE_RERANKER=true
ENABLE_HYBRID_SEARCH=true
ENABLE_QUERY_REWRITING=true
ENABLE_TOOL_USE=false                       # agent-driven retrieval; default off

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Web (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_PORT=3000
